# Copy this file to .env on your personal PC ONLY (never commit .env)
ENV_MODE=development

# Execution mode:
#   signal_only = Default Copilot mode (prints Setup Card + desktop/Telegram alert, NEVER places orders)
#   confirm     = Asks [Y/n] in terminal before sending order to MetaTrader 5
#   auto        = Automatically sends orders to MetaTrader 5 (use on Demo account first)
EXECUTION_MODE=signal_only

# MetaTrader 5 Credentials (used only on Personal PC where MT5 terminal is installed)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# Risk Management
ACCOUNT_EQUITY_DEFAULT=10000.0
RISK_PER_TRADE_PCT=0.5
MAX_DAILY_DRAWDOWN_PCT=2.0
MIN_CONFLUENCE_SCORE=65.0

# Kronos AI Foundation Model Configuration (RTX 5060 8GB VRAM -> Kronos-base)
KRONOS_ENABLED=true
KRONOS_MODEL_ID=NeoQuasar/Kronos-base
KRONOS_TOKENIZER_ID=NeoQuasar/Kronos-Tokenizer-base
KRONOS_FALLBACK_MODEL_ID=NeoQuasar/Kronos-small
KRONOS_DEVICE=cuda
KRONOS_SAMPLE_COUNT=10
KRONOS_LOOKBACK=256
KRONOS_PRED_LEN=12

# Optional Telegram Alert Webhook (for receiving Signal Cards on your phone)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
